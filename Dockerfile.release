# Takes a binary the build matrix already produced. Compiling Rust for two
# architectures under emulation costs far more than cross-compiling once.
FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata

RUN addgroup -S palmcast && adduser -S -G palmcast palmcast

# The state file holds a token for every live room, so it lives on a volume the
# service owns rather than in the image.
RUN mkdir -p /data && chown -R palmcast:palmcast /data
WORKDIR /data

ARG TARGETARCH
COPY dist/palmcast-${TARGETARCH} /usr/local/bin/palmcast
RUN chmod +x /usr/local/bin/palmcast

USER palmcast
EXPOSE 8080

ENV PALMCAST_PORT=8080 \
    PALMCAST_BIND=0.0.0.0 \
    PALMCAST_STATE_FILE=/data/state.json

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/palmcast"]
